#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# Enable all hardening flags
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Include buildflags.mk for compiler flag handling
include /usr/share/dpkg/buildflags.mk

# Get the multiarch library directory
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_autoreconf:
	# Run autogen.sh which calls autoreconf internally
	bash autogen.sh

override_dh_auto_configure:
	dh_auto_configure -- \
		--libdir=/usr/lib/$(DEB_HOST_MULTIARCH)/security

# More explicit override
override_dh_install:
	# Skip dh_install as files are already in place from make install
	true
